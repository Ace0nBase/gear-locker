rules_version = '2';
// Each signed-in user can read and write only their own files.
// Signed-out users cannot read or write anything.
// The app does not upload files today. Compare this with the live console
// rules before deploying storage, so a path difference cannot replace them.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
